{# Wiederkehrende Bausteine der Seite #}

{% macro infos(s) %}
{%- if s.bgg %}
<ul class="chips">
  {%- if s.bgg | spieler %}<li>{{ s.bgg | spieler }}</li>{% endif %}
  {%- if s.bgg | dauer %}<li>{{ s.bgg | dauer }}</li>{% endif %}
  {%- if s.bgg.komplexitaet %}<li>Komplexität {{ s.bgg.komplexitaet | zahlDe }}/5</li>{% endif %}
</ul>
{%- endif %}
{% endmacro %}

{% macro cover(s, klasse) %}
{%- if s.bgg and s.bgg.cover %}<img class="{{ klasse }}" src="{{ s.bgg.cover | url }}" alt="" loading="lazy">
{%- else %}<div class="{{ klasse }}" aria-hidden="true">{{ s.name | first | upper }}</div>{% endif %}
{% endmacro %}

{% macro spielkarte(eintrag, platz) %}
<li class="spiel">
  <span class="rang" aria-label="Platz {{ platz }}">{{ platz }}</span>
  {{ cover(eintrag.spiel, "bild") }}
  <div>
    <h3><a href="{{ ('/spiele/' + eintrag.spiel.slug + '/') | url }}">{{ eintrag.spiel.name }}</a></h3>
    <p class="partien">{{ eintrag.partien }} {{ "Partie" if eintrag.partien == 1 else "Partien" }}{% if eintrag.spielzeit %} · {{ eintrag.spielzeit | spielzeit }}{% endif %}</p>
    {{ infos(eintrag.spiel) }}
    {%- if eintrag.spiel.bewertung %}
    <a class="fokus-hinweis" href="{{ ('/spiele/' + eintrag.spiel.slug + '/#bewertung') | url }}">Im Fokus{% if eintrag.spiel.bewertung.schnitt %} · unsere Note {{ eintrag.spiel.bewertung.schnitt }}{% endif %}</a>
    {%- endif %}
  </div>
</li>
{% endmacro %}

{# Eine Zeile der Hotlist #}
{% macro hotzeile(e) %}
<li><a href="{{ ('/spiele/' + e.spiel.slug + '/') | url }}">{{ e.spiel.name }}</a>
  {%- if e.spiel.bewertung %} <a class="fokus-marke" href="{{ ('/spiele/' + e.spiel.slug + '/#bewertung') | url }}">Im Fokus{% if e.spiel.bewertung.schnitt %} {{ e.spiel.bewertung.schnitt }}<span class="nur-sr"> von 10</span>{% endif %}</a>{% endif %}
  <span>{{ e.spielzeit | spielzeit or (e.partien + "×") }}</span></li>
{% endmacro %}

{# Kurze Einordnung wie „Familien mit Kindern“, verlinkt auf die passende Empfehlungsgruppe #}
{% macro einordnung(f) %}
{%- if f.einordnungen.length %}
<ul class="einordnung" aria-label="Passt für">
  {%- for e in f.einordnungen %}<li><a href="{{ ('/im-fokus/#' + e.anker) | url }}">{{ e.name }}</a></li>{% endfor %}
</ul>
{%- endif %}
{% endmacro %}

{% macro terminzeile(t, mitAdresse) %}
<li{% if t.farbe %} class="farbe-{{ t.farbe }}"{% endif %}>
  <time datetime="{{ t.datum }}"><span class="tag">{{ t.teile.tag }}</span><span class="zahl">{{ t.teile.zahl }}</span><span class="monat">{{ t.teile.monat }}</span></time>
  <div>
    <span class="etikett">{{ t.art }}</span>
    <div class="ort">{{ t.ort or "Ort folgt" }}</div>
    <div class="info">{% if t.bisText %}{{ t.bisText }} · {% endif %}{{ ("ab " + t.zeit) if t.zeit else "Uhrzeit folgt" }}</div>
    {%- if t.kostenText %}<div class="kosten">{{ t.kostenText }}</div>{% endif %}
    {%- if t.hinweis %}<div class="hinweis">{{ t.hinweis }}</div>{% endif %}
    {%- if mitAdresse and t.ort %}<div class="info">{{ t.adresse or "Adresse folgt" }}</div>{% endif %}
    {%- if t.adresse %}<a href="https://www.openstreetmap.org/search?query={{ t.adresse | urlencode }}" rel="noopener" aria-label="Route zu {{ t.ort }}">Route</a>{% endif %}
  </div>
</li>
{% endmacro %}

{# Spiel im Fokus. modus: "voll" (Seite Im Fokus), "kurz" (Startseite, ohne Plus/Minus und O-Töne),
   "spielseite" (auf der Seite des Spiels, ohne Bild und Namen). h = Stufe der obersten Überschrift #}
{% macro bewertung(f, modus, h) %}
{%- set h2 = h + 1 %}
{%- set kurz = modus == "kurz" %}
<article class="bewertung" id="{{ 'bewertung' if modus == 'spielseite' else f.spiel.slug }}">
  <div class="bew-text">
    {%- if modus == "spielseite" %}
    {%- if f.monatText %}<p class="eyebrow">Im Fokus: {{ f.monatText }}</p>{% endif %}
    <h{{ h }} class="bew-name">Unsere Bewertung</h{{ h }}>
    {%- else %}
    <div class="bew-kopf">
      {{ cover(f.spiel, "bew-bild") }}
      <div>
        {%- if f.monatText %}<p class="eyebrow">Im Fokus: {{ f.monatText }}</p>{% endif %}
        <h{{ h }} class="bew-name"><a href="{{ ('/spiele/' + f.spiel.slug + '/') | url }}">{{ f.spiel.name }}</a></h{{ h }}>
        {{ infos(f.spiel) }}
      </div>
    </div>
    {%- endif %}
    {{ einordnung(f) }}
    <p>{{ f.zusammenfassung }}</p>
    {%- if f.fuerWen %}<p><b>Für wen?</b> {{ f.fuerWen }}</p>{% endif %}
    {%- if not kurz and (f.positiv.length or f.negativ.length) %}
    <div class="plusminus">
      {%- if f.positiv.length %}
      <div class="plus"><h{{ h2 }}>Das gefällt uns</h{{ h2 }}><ul>{% for p in f.positiv %}<li>{{ p }}</li>{% endfor %}</ul></div>
      {%- endif %}
      {%- if f.negativ.length %}
      <div class="minus"><h{{ h2 }}>Das gefällt uns weniger</h{{ h2 }}><ul>{% for p in f.negativ %}<li>{{ p }}</li>{% endfor %}</ul></div>
      {%- endif %}
    </div>
    {%- endif %}
    {%- if kurz %}<p><a href="{{ ('/spiele/' + f.spiel.slug + '/#bewertung') | url }}">Ganze Bewertung lesen</a></p>{% endif %}
  </div>
  <div class="fokus-wertung">
    <h{{ h2 }} class="w-titel">Unsere Note</h{{ h2 }}>
    {%- if f.schnitt %}
    <p class="note"><span class="note-zahl">{{ f.schnitt }}</span> von 10</p>
    <p class="w-info">{{ f.stimmen }} {{ "Stimme" if f.stimmen == 1 else "Stimmen" }}{% if f.spiel.bgg and f.spiel.bgg.bewertung %} · BGG-Schnitt {{ f.spiel.bgg.bewertung | zahlDe }}{% endif %}</p>
    <table class="verteilung">
      <caption>So haben wir abgestimmt</caption>
      <thead class="nur-sr"><tr><th scope="col">Note</th><th scope="col">Anteil</th><th scope="col">Stimmen</th></tr></thead>
      <tbody>
        {%- for v in f.verteilung %}
        <tr><th scope="row"><b>{{ v.note }}</b> {{ v.kurz }}</th><td><span class="balken" aria-hidden="true"><i style="width:{{ v.anteil }}%"></i></span></td><td class="anz">{{ v.anzahl }}</td></tr>
        {%- endfor %}
      </tbody>
    </table>
    {%- else %}
    <p class="w-info">Die Abstimmung läuft noch.</p>
    {%- endif %}
  </div>
  {%- if not kurz and f.otoene.length %}
  <details class="otoene">
    <summary>O-Töne aus unserer Runde ({{ f.otoene.length }})</summary>
    <ul>
      {%- for o in f.otoene %}
      <li><b>{{ ("Spieler " + o.name) if o.name else "Ein Mitglied" }}</b> sagt: <q>{{ o.zitat }}</q></li>
      {%- endfor %}
    </ul>
  </details>
  {%- endif %}
</article>
{% endmacro %}

{% macro flamme() %}<svg class="flamme" viewBox="0 0 24 24" aria-hidden="true"><path fill="#cf4639" d="M12 2c1 4 6 6.500 6 12a6 6 0 0 1-12 0c0-2.500 1.200-4 2.500-5.200.3 1.700 1 2.700 2 3.200C10 8.500 10.500 5 12 2z"/></svg>{% endmacro %}
