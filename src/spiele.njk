---
layout: basis.njk
titel: Spiele
beschreibung: Was bei uns auf den Tisch kommt. Die meist gespielten Spiele der letzten 12 Monate, Hotlist, Hall of Fame, unsere Bewertungen und unsere Sammlung.
permalink: /spiele/
---
{% import "bausteine.njk" as b %}
<section class="sektion" aria-labelledby="h-spiele">
  <div class="wrap">
    <h1 class="seiten-titel" id="h-spiele">Spiele</h1>
    <p class="lead">Mit diesen Spielen verbringen wir die meiste Zeit. Du musst keine Regeln kennen, wir erklären sie dir.</p>
    {#- Ranglisten als Cover mit Platz, darunter Spielzeit und Partien #}
    {%- macro rangreihe(liste, anzahl) %}
    {%- import "bausteine.njk" as b %}
    <ol class="cover-reihe rang-reihe">
      {%- for e in liste | batch(anzahl) | first %}{{ b.coverKachel(e.spiel, e.spielzeit | spielzeit, loop.index, e.partien + (" Partie" if e.partien == 1 else " Partien")) }}{% endfor %}
    </ol>
    {%- endmacro %}
    <div class="rangliste">
      <h2 class="band-h">Letzte 12 Monate <span class="klein-info">{{ daten.zahlen12.abende }} Spieletreffen, {{ daten.zahlen12.partien }} Partien</span></h2>
      {{ rangreihe(daten.meist12, 10) }}
    </div>
    {%- if daten.meist3.length %}
    <div class="rangliste">
      <h2 class="band-h">{{ b.flamme() }} Hotlist: letzte 3 Monate <span class="klein-info">{{ daten.zahlen3.abende }} Spieletreffen, {{ daten.zahlen3.partien }} Partien</span></h2>
      {{ rangreihe(daten.meist3, 10) }}
    </div>
    {%- endif %}
    {%- if daten.hallOfFame.length %}
    <div class="rangliste ruhm-reihe">
      <h2 class="band-h"><svg class="krone" viewBox="0 0 24 24" aria-hidden="true"><path fill="#b86f12" d="M3 18h18l1-11-5.5 4L12 4l-4.5 7L2 7l1 11zm0 2h18v2H3z"/></svg> Hall of Fame <span class="klein-info">Die meiste Spielzeit seit {{ daten.hallOfFameSeit }}</span></h2>
      {{ rangreihe(daten.hallOfFame, 5) }}
    </div>
    {%- endif %}
    <p class="klein-info ohne-einzug">Gezählt wird die Spielzeit: Partien × maximale Spieldauer laut BoardGameGeek.</p>
    {%- if daten.letzterAbend %}
    <div class="letzter">
      <h2>Zuletzt gespielt <span class="klein-info">Spieletreffen am {{ daten.letzterAbend.datum }}</span></h2>
      <ul class="cover-reihe">
        {%- for s in daten.letzterAbend.spiele %}{{ b.coverKachel(s) }}{% endfor %}
      </ul>
    </div>
    {%- endif %}
  </div>
</section>

{%- if daten.fokus.length %}
<section class="sektion" id="bewertungen" aria-labelledby="h-bewertungen" style="padding-top:0">
  <div class="wrap">
    <h2 id="h-bewertungen">Unsere Bewertungen</h2>
    {{ b.fokusKasten(daten.fokus[0], 3) }}
    {%- if daten.fokus.length > 1 %}
    <h3 class="band-h">Frühere Bewertungen</h3>
    <ul class="fokus-archiv">
      {%- for f in daten.fokus %}{% if not loop.first %}
      <li class="archiv-karte">
        {{ b.cover(f.spiel, "bild") }}
        <div>
          {%- if f.monatText %}<p class="eyebrow">{{ f.monatText }}</p>{% endif %}
          <h4><a href="{{ ('/spiele/' + f.spiel.slug + '/#bewertung') | url }}">{{ f.spiel.name }}</a></h4>
          {%- if f.schnitt %}<p class="archiv-note">Unsere Note {{ f.schnitt }} von 10</p>{% endif %}
          {%- if f.einordnungen.length %}<p class="archiv-einordnung">{% for e in f.einordnungen %}{{ e.name }}{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}
        </div>
      </li>
      {%- endif %}{% endfor %}
    </ul>
    {%- endif %}
  </div>
</section>
{%- endif %}

<section class="sektion karten-paar" aria-label="Sammlung und Empfehlungen" style="padding-top:0">
  <div class="wrap">
    {{ b.sammlungKarte(daten.sammlung.length) }}
    {%- if daten.empfehlungen.length %}{{ b.einstiegKarte() }}{% endif %}
  </div>
</section>
