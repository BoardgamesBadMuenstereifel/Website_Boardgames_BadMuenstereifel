<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if titel %}{{ titel }} – {% endif %}{{ verein.name }}</title>
  <meta name="description" content="{{ beschreibung or 'Brettspielclub in 53902 Bad Münstereifel: Komm einfach zum nächsten Spieleabend. Unter der Woche kostenlos und ohne Anmeldung, du brauchst kein Spiel mitzubringen.' }}">
  <meta name="theme-color" content="#514859">
  <link rel="icon" href="{{ '/assets/logo/favicon-32.png' | url }}" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="{{ '/assets/logo/apple-touch-icon.png' | url }}">
  <link rel="preload" href="{{ '/assets/schriften/fraunces-latin-700-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
</head>
<body>
  <a class="skip" href="#inhalt">Zum Inhalt springen</a>
  <header class="kopf">
    <div class="wrap">
      <a class="logo" href="{{ '/' | url }}">
        <img src="{{ '/assets/logo/logo-112.webp' | url }}" width="124" height="112" alt="">
        <span>Boardgames<br>Bad Münstereifel</span>
      </a>
      <nav aria-label="Hauptmenü">
        <details class="nav-menue" id="nav">
          <summary>Menü</summary>
          <ul>
            {%- set punkte = [["/", "Start"], ["/neu-hier/", "Neu hier?"], ["/termine/", "Termine"], ["/spiele/", "Spiele"], ["/im-fokus/", "Im Fokus"], ["/kontakt/", "Über uns & Kontakt"]] %}
            {%- for p in punkte %}{% if p[0] != "/im-fokus/" or daten.fokus.length or daten.empfehlungen.length %}
            <li><a href="{{ p[0] | url }}"{% if page.url == p[0] or (p[0] == "/spiele/" and page.url.startsWith("/spiele/")) %} aria-current="page"{% endif %}>{{ p[1] }}</a></li>
            {%- endif %}{% endfor %}
          </ul>
        </details>
      </nav>
    </div>
  </header>

  <main id="inhalt">
{{ content | safe }}
  </main>

  <footer class="fuss">
    <div class="wrap">
      <div class="spalten">
        <div class="fuss-marke">
          <img src="{{ '/assets/logo/logo-256.webp' | url }}" width="282" height="256" alt="" loading="lazy">
          <h2>{{ verein.name }}</h2>
          <p>Brettspielclub in 53902 Bad Münstereifel</p>
        </div>
        <div>
          <h2>Folge uns</h2>
          <ul>
            <li><a href="{{ verein.instagram }}" rel="noopener">Instagram</a></li>
            <li><a href="{{ verein.facebook }}" rel="noopener">Facebook</a></li>
          </ul>
        </div>
        <div>
          <h2>Rechtliches</h2>
          <ul>
            <li><a href="{{ '/impressum/' | url }}">Impressum</a></li>
            <li><a href="{{ '/datenschutz/' | url }}">Datenschutzerklärung</a></li>
          </ul>
        </div>
      </div>
      <p class="klein">Powered by <a href="https://boardgamegeek.com" rel="noopener">BGG</a>: Spielinfos von BoardGameGeek. Diese Seite setzt keine Cookies und lädt keine Tracker.</p>
    </div>
  </footer>
  <script src="{{ '/assets/script.js' | url }}" defer></script>
</body>
</html>
