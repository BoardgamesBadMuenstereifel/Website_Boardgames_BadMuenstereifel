---
layout: basis.njk
pagination:
  data: daten.alleSpiele
  size: 1
  alias: spiel
  addAllPagesToCollections: true
permalink: "/spiele/{{ spiel.slug }}/"
eleventyComputed:
  titel: "{{ spiel.name }}"
---
{% import "bausteine.njk" as b %}
{%- set fokus = daten.fokusNachSlug[spiel.slug] %}
<section class="sektion" aria-labelledby="h-spiel">
  <div class="wrap">
    <p class="brotkrume"><a href="{{ '/spiele/' | url }}">Zurück zu den Spielen</a></p>
    <article class="spiel-seite">
      <div class="spiel-kopf">
        {{ b.cover(spiel, "spiel-cover") }}
        <div>
          <h1 class="seiten-titel" id="h-spiel">{{ spiel.name }}</h1>
          {%- if fokus %}<p class="fokus-hinweis-gross"><a href="#bewertung">Unsere Bewertung</a></p>{% endif %}
          <ul class="spiel-bei-uns">
            {%- if spiel.sammlung %}<li>Gehört zu unserer <a href="{{ '/spiele/sammlung/' | url }}">Sammlung</a></li>{% endif %}
            {%- if spiel.partienGesamt %}<li>Bei uns {{ spiel.partienGesamt }}-mal gespielt, zuletzt am {{ spiel.zuletztGespielt }}</li>{% endif %}
          </ul>
        </div>
      </div>
      {%- if spiel.bgg %}
      <dl class="fakten">
        {%- if spiel.bgg | spieler %}<div><dt>Spieleranzahl</dt><dd>{{ spiel.bgg | spieler }}</dd></div>{% endif %}
        {%- if spiel.bgg | dauer %}<div><dt>Dauer</dt><dd>{{ spiel.bgg | dauer }}</dd></div>{% endif %}
        {%- if spiel.bgg.alter %}<div><dt>Alter</dt><dd>ab {{ spiel.bgg.alter }} Jahren</dd></div>{% endif %}
        {%- if spiel.bgg.komplexitaet %}<div><dt>Komplexität</dt><dd>{{ spiel.bgg.komplexitaet | zahlDe }} von 5</dd></div>{% endif %}
        {%- if spiel.bgg.bewertung %}<div><dt>Bei BoardGameGeek</dt><dd>{{ spiel.bgg.bewertung | zahlDe }} von 10</dd></div>{% endif %}
      </dl>
      <p><a href="https://boardgamegeek.com/boardgame/{{ spiel.bggId }}" rel="noopener">Beschreibung und mehr bei BoardGameGeek</a></p>
      {%- else %}
      <p>Zu diesem Spiel haben wir noch keine weiteren Infos.</p>
      {%- endif %}
    </article>
    {%- if spiel.fotos and spiel.fotos.length %}
    <div class="vom-tisch">
      {%- for f in spiel.fotos %}
      <div class="sofortbild einzeln" style="--i: {{ loop.index0 }}">
        <figure>
          {{ b.bild(f, "(min-width: 46rem) 42rem, 92vw") }}
          <figcaption><strong>Bei uns auf dem Tisch</strong>{% if f.unterschrift %} <span>{{ f.unterschrift }}</span>{% endif %}</figcaption>
        </figure>
      </div>
      {%- endfor %}
    </div>
    {%- endif %}
    {%- if fokus %}
    <div class="spiel-bewertung">
      {{ b.bewertung(fokus, "spielseite", 2, daten.bggSkala) }}
    </div>
    {%- endif %}
  </div>
</section>
